{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-models-discovery",
  "version": "1.6.1",
  "description": "OpenCode plugin for auto-discovery of OpenAI-compatible models with dynamic provider configuration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "compile": "npm run compile:root && npm run compile:server",
    "compile:root": "esbuild src/index.ts --bundle --format=esm --platform=node --packages=external --target=node18 --sourcemap --keep-names --outfile=dist/index.js",
    "compile:server": "esbuild src/server.ts --bundle --format=esm --platform=node --packages=external --target=node18 --sourcemap --keep-names --outfile=dist/server.js",
    "build": "npm run typecheck && npm run test:run && npm run compile",
    "test:e2e": "node test-v2/combined-package/e2e.mjs",
    "validate": "npm run lint && npm run typecheck && npm run test:run",
    "validate:config": "bun scripts/validate-config.ts",
    "release": "bun scripts/release.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "openai-compatible",
    "model-discovery",
    "plugin",
    "local-llm",
    "ollama",
    "lmstudio",
    "lm-studio",
    "localai"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "opencode": ">=1.18.29"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuhp/opencode-models-discovery.git"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.14",
    "xdg-basedir": "^5.1.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.29"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode-ai/plugin": "^1.17.10",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
